{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm --prefix frontend ci",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist/frontend",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
